{
  "catalogue_version": "2.2.0",
  "category": "functional",
  "templates": [
    {
      "name": "Booking",
      "slug": "template-booking",
      "type": "functional-template",
      "category": "functional",
      "description": "Reusable appointment, reservation, capacity and service-booking experience inside the shared Chatbot shell.",
      "icon": "calendar",
      "color": "#06B6D4",
      "order": 100,
      "platform_app": "titan-hub",
      "platform_apps": ["titan-zero", "titan-go", "titan-desk", "titan-hub"],
      "roles": ["owner", "manager", "reception", "dispatcher", "provider", "customer"],
      "features": ["service-catalogue", "availability", "appointments", "reservations", "capacity", "staff-selection", "resource-selection", "waitlists", "deposits", "intake-forms", "recurring-bookings", "rescheduling", "cancellation", "offline-booking-request"],
      "commerce_modes": ["service", "booking", "reservation", "class", "event"],
      "workcore": {
        "domains": ["CRM", "Catalogue", "Scheduling", "Capacity", "Workforce", "Premises", "Assets", "Finance", "Forms", "Documents"],
        "commands": ["booking.request.create", "booking.reschedule.request", "booking.cancel.request"],
        "read_models": ["booking_offerings", "booking_availability", "booking_status"]
      },
      "offline": {
        "records": ["booking_offerings", "availability_snapshots", "booking_requests", "booking_status", "drafts", "outbox", "conflicts"],
        "packs": ["functional-booking-default"],
        "commands": ["booking.request.queue", "booking.reschedule.queue", "booking.cancel.queue"],
        "conflict_rules": {"server_authoritative": true, "preserve_local_copy": true}
      },
      "chatbot": {
        "name": "Booking Assistant",
        "role": "Booking and reservation assistant",
        "system_prompt": "Help the user discover services, prepare bookings and manage booking requests. Offline selections and scarce-resource reservations remain pending until WorkCore confirms availability.",
        "suggested_prompts": ["Book a service", "Show available times", "Change my booking"]
      },
      "navigation": {
        "default_view": "book",
        "primary": [
          {"id": "services", "label": "Services", "icon": "list", "offline": true},
          {"id": "book", "label": "Book", "icon": "calendar", "offline": true},
          {"id": "bookings", "label": "My bookings", "icon": "bookings", "offline": true},
          {"id": "account", "label": "Account", "icon": "user", "offline": true}
        ],
        "drawer": [],
        "header_actions": ["sync", "notifications", "settings"]
      },
      "home": {"widgets": ["upcoming_booking", "availability", "booking_status"], "quick_actions": ["book", "reschedule"]},
      "permissions": ["template-booking.view", "template-booking.request"]
    },
