{
  "name": "Titan Nova",
  "slug": "titan-nova",
  "type": "venture-builder",
  "version": "3.0.0",
  "description": "Evidence-led venture discovery, vertical design, simulation, pilot launch and continuous improvement for Titan Zero.",
  "icon": "🧬",
  "color": "#6d5dfc",
  "theme": {
    "primary": "#6d5dfc",
    "gradient": "linear-gradient(135deg, #6d5dfc, #4338ca)"
  },
  "wizard_steps": [
    "Discover",
    "Model",
    "Simulate",
    "Validate",
    "Launch",
    "Learn"
  ],
  "features": [
    "opportunity-discovery",
    "capability-isomorphism",
    "idle-capacity-arbitrage",
    "vertical-genome",
    "workcore-simulation",
    "monte-carlo-simulation",
    "offer-design",
    "unit-economics",
    "anchor-account-validation",
    "pilot-mission-control",
    "curriculum-compilation",
    "capability-passports",
    "mission-ledger",
    "model-council-gates",
    "living-genome"
  ],
  "chatbot": {
    "name": "Titan Nova Operator",
    "role": "Venture discovery, validation and launch orchestrator",
    "system_prompt": "You are the Titan Nova Operator. Turn evidence, business capabilities and market constraints into governed venture experiments. Preserve WorkCore as the operational system of record, require approval for consequential actions, record receipts, and clearly separate hypotheses from verified facts.",
    "suggested_prompts": [
      "Find the strongest adjacent opportunity",
      "Build a vertical launch genome",
      "Simulate this business model",
      "Design an anchor-customer pilot",
      "Compile the training pathway",
      "Show the next governed mission"
    ]
  },
  "tier1_manager": "VentureLaunchManager",
  "tier2_specialists": [
    "OpportunityResearchSpecialist",
    "VerticalGenomeSpecialist",
    "VentureSimulationSpecialist",
    "PilotLaunchSpecialist"
  ],
  "tier3_actions": [
    "CollectEvidenceAgent",
    "ScoreOpportunityAgent",
    "CompileVerticalGenomeAgent",
    "RunVentureSimulationAgent",
    "CreateAnchorAccountMissionAgent",
    "CreatePilotMissionAgent",
    "RecordMissionReceiptAgent",
    "UpdateLivingGenomeAgent"
  ],
  "database": {
    "tables": [
      "ext_titan_nova_agents",
      "ext_titan_nova_tasks"
    ],
    "authority": "Titan Nova owns venture hypotheses, experiments, missions and learning. WorkCore owns customers, bookings, jobs, workforce, invoices, payments and operational records."
  },
  "permissions": [
    "titan-nova:view",
    "titan-nova:create-mission",
    "titan-nova:simulate",
    "titan-nova:approve",
    "titan-nova:execute",
    "titan-nova:view-receipts",
    "titan-nova:update-genome"
  ],
  "models": [
    "TitanNovaAgent",
    "TitanNovaTask"
  ],
  "settings": {
    "approval_required_for_external_actions": true,
    "workcore_is_operational_authority": true,
    "record_action_receipts": true,
    "simulation_before_launch": true,
    "minimum_anchor_accounts": 1
  }
}
